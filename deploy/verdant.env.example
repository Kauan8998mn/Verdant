NODE_ENV=production
VERDANT_HOST=127.0.0.1
VERDANT_PORT=43110
PUBLIC_ORIGIN=https://verdant.example.com
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_ADDRESS=REPLACE_PUBLIC_IPV4
MEDIASOUP_PORT=43111
DATABASE_PATH=/var/lib/verdant/verdant.sqlite
DATA_DIR=/var/lib/verdant
UPLOAD_PATH=/var/lib/verdant/uploads
UPLOAD_MAX_MB=50
VERDANT_DEBUG_WEBRTC=false
VERDANT_ICE_POLICY=all
VERDANT_TURN_TRANSPORT=all
# Stage 1: prove direct media before enabling TURN.
TURN_ENABLED=false
TURN_HOST=turn.example.com
TURN_PORT=3478
TURN_TLS_ENABLED=true
TURN_TLS_PORT=5349
TURN_REALM=verdant.example.com
TURN_SECRET=
TURN_TTL_SECONDS=3600
# Actual IPv4 on the VM interface (OCI generally maps a public IP to this).
TURN_LISTEN_IP=REPLACE_VM_INTERFACE_IPV4
TURN_RELAY_MIN=40000
TURN_RELAY_MAX=40100
